{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      ".env.local",
      ".secret.local",
      "firebase-debug*.log",
      "test",
      "provision-user.cjs"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "target": "site-moi",
    "public": "hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/pages/chung/gioi-thieu.html",
        "type": 302
      }
    ]
  }
}
