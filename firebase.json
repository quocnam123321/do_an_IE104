{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      ".env.local",
      ".secret.local",
      "firebase-debug*.log",
      "test",
      "provision-user.cjs"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "target": "site-moi",
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/pages/chung/gioi-thieu.html",
        "type": 302
      },
      {
        "source": "/pages/chung/thong-bao-ke-hoach-hoc-vu.html",
        "destination": "/pages/chung/thong-bao.html?loai=ke-hoach-hoc-vu",
        "type": 301
      },
      {
        "source": "/pages/chung/thong-bao-bao-cao-nop-bai.html",
        "destination": "/pages/chung/thong-bao.html?loai=bao-cao-nop-bai",
        "type": 301
      },
      {
        "source": "/pages/chung/thong-bao-lich-bao-ve.html",
        "destination": "/pages/chung/thong-bao.html?loai=lich-bao-ve",
        "type": 301
      },
      {
        "source": "/pages/chung/thong-bao-tong-ket-vinh-danh.html",
        "destination": "/pages/chung/thong-bao.html?loai=tong-ket-vinh-danh",
        "type": 301
      },
      {
        "source": "/pages/chung/thong-bao-trang-2.html",
        "destination": "/pages/chung/thong-bao.html?trang=2",
        "type": 301
      }
    ]
  }
}
